{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@abstractframework/monitor-active-memory": ["../abstractuic/monitor-active-memory/src/index.ts"],
      "@abstractframework/monitor-active-memory/*": ["../abstractuic/monitor-active-memory/src/*"],
      "@abstractframework/monitor-flow": ["../abstractuic/monitor-flow/src/index.ts"],
      "@abstractframework/monitor-flow/*": ["../abstractuic/monitor-flow/src/*"],
      "@abstractframework/panel-chat": ["./node_modules/@abstractframework/panel-chat/dist/index.d.ts"],
      "@abstractframework/ui-kit": ["./node_modules/@abstractframework/ui-kit/dist/index.d.ts"],
      "@abstractframework/monitor-gpu": ["../abstractuic/monitor-gpu/src/index.d.ts"],
      "reactflow": ["./node_modules/reactflow/dist/esm/index.d.ts"],
      "reactflow/*": ["./node_modules/reactflow/*"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

